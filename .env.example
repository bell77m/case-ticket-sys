# Local development defaults. Copy to .env to override. Never put real secrets here;
# staging and production get their values from Vault.

HTTP_ADDR=:8080
# App user: no UPDATE/DELETE on audit_log (FR-L2). Migrations run as the owner.
DATABASE_URL=postgres://ticket_app:ticket_app@localhost:5432/ticket?sslmode=disable
MIGRATE_DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket?sslmode=disable
REDIS_URL=redis://localhost:6379/0
OIDC_ISSUER=http://localhost:5556
OIDC_CLIENT_ID=ticket-app
OIDC_CLIENT_SECRET=dev-only-secret
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:5173

# Optional: leave SMTP_ADDR empty to turn staff email off.
SMTP_ADDR=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
