{
  "extraKnownMarketplaces": {
    "svelte": { "source": { "source": "github", "repo": "sveltejs/ai-tools" } }
  },
  "enabledPlugins": {
    "svelte@svelte": true,
    "gopls-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/task-done.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go build:*)", "Bash(go test:*)", "Bash(go vet:*)", "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)", "Bash(npm run:*)", "Bash(npx svelte-check:*)",
      "Bash(node scripts/check-i18n.mjs)", "Bash(make:*)", "Bash(docker compose:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(**/secrets/**)"]
  }
}
