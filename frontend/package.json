{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test:e2e": "playwright test",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --disable-async-local-storage --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/qrcode": "^1.5.6",
		"axe-core": "^4.13.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource/noto-sans": "^5.3.0",
		"@fontsource/noto-sans-myanmar": "^5.3.0",
		"@fontsource/noto-sans-sc": "^5.3.0",
		"@fontsource/noto-sans-thai": "^5.3.0",
		"chart.js": "^4.5.1",
		"myanmar-tools": "1.1.3",
		"qrcode": "^1.5.4"
	}
}
